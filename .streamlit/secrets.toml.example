# Copie este arquivo para "secrets.toml" (mesma pasta) e preencha com a
# senha/usuários reais. O arquivo "secrets.toml" está no .gitignore e NUNCA
# deve ser enviado ao GitHub.

# Opção simples: um usuário só, senha única
# app_password = "TROQUE_ESTA_SENHA"

# Opção com vários usuários (recomendado)
[usuarios]
funcionario = "TROQUE_ESTA_SENHA"
